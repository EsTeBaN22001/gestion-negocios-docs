# ══════════════════════════════════════════════════════════════════════════════
# Gestión Negocios — Variables de entorno de ejemplo
# Copiar a .env y ajustar los valores. NUNCA versionar el .env real.
# ══════════════════════════════════════════════════════════════════════════════

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_DATABASE=gestion_negocios
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ─── Backend (ASP.NET Core) ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# La cadena de conexión usa el nombre de servicio "mysql" cuando corre en Docker.
# Para ejecución local, cambiar "mysql" por "localhost".
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=gestion_negocios;User=appuser;Password=change-me;

# ─── JWT (Autenticación) ───────────────────────────────────────────────────────
# Clave secreta simétrica (mínimo 32 caracteres / 256 bits).
Jwt__Key=DevelopmentSecretKeyForLocalTestingMustBeAtLeast32BytesLong!
Jwt__Issuer=GestionNegociosApi
Jwt__Audience=GestionNegociosFrontend
Jwt__DurationMinutes=60

# ─── Seed inicial (desarrollo) ────────────────────────────────────────────────
# Credenciales del usuario administrador y empleado iniciales (solo desarrollo)
Seed__AdminEmail=admin@gestionnegocios.local
Seed__AdminPassword=Admin123*
Seed__EmployeeEmail=empleado@gestionnegocios.local
Seed__EmployeePassword=Empleado123*

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL del frontend permitida por CORS (sin barra final)
Cors__AllowedOrigins__0=http://localhost:4200

# ─── Frontend (Angular) ───────────────────────────────────────────────────────
# URL base de la API consumida por Angular
API_BASE_URL=http://localhost:5000
