# Development environment example
# Copy to .env locally. Never commit the real .env.

MYSQL_DATABASE=gestion_negocios
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Backend
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=gestion_negocios;User=appuser;Password=change-me;

# Frontend
API_BASE_URL=http://localhost:5000
